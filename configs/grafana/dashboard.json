{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"}
  ],
  "annotations": {
    "list": [
      {"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true,
       "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts",
       "type": "dashboard"}
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "SQL 查询错误率",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "(sum(rate(query_errors_total[5m])) or vector(0)) / clamp_min(sum(rate(query_requests_total[5m])), 0.0001)",
         "legendFormat": "错误率", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 2,
      "title": "SQL 查询延迟 P95 / P99",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(query_latency_overall_seconds_bucket[5m])))",
         "legendFormat": "P95", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(query_latency_overall_seconds_bucket[5m])))",
         "legendFormat": "P99", "refId": "B"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    },
    {
      "id": 3,
      "title": "业务连接池饱和度",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "db_pool_saturation_business", "legendFormat": "业务池", "refId": "A"},
        {"expr": "db_pool_saturation_policy", "legendFormat": "策略池", "refId": "B"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 4,
      "title": "SQL 查询超时率",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "(sum(rate(query_errors_total{code=\"query_timeout\"}[5m])) or vector(0)) / clamp_min(sum(rate(query_errors_total[5m])), 0.0001)",
         "legendFormat": "超时率", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 5,
      "title": "MCP 工具失败率",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "((sum(rate(mcp_requests_total{status=\"error\"}[5m])) or vector(0)) + (sum(rate(tool_business_errors_total[5m])) or vector(0))) / clamp_min(sum(rate(mcp_requests_total[5m])), 0.0001)",
         "legendFormat": "工具失败率", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 6,
      "title": "请求吞吐 (QPS)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(mcp_requests_total{method=~\".+\"}[5m]))",
         "legendFormat": "请求/s", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 7,
      "title": "SQL 执行量/错误量 (按状态)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (status) (rate(query_executions_total[5m]))",
         "legendFormat": "{{status}}", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []}
    },
    {
      "id": 8,
      "title": "审计写入健康",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(audit_persisted_total[5m]))", "legendFormat": "落库/s", "refId": "A"},
        {"expr": "sum(rate(audit_write_failures_total[5m]))", "legendFormat": "失败/s", "refId": "B"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {}, "overrides": []}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["sql-mcp", "observability"],
  "templating": {
    "list": [
      {
        "current": {"text": "Prometheus", "value": "default"},
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "SQL MCP Observability",
  "uid": "sql-mcp-observability",
  "version": 1,
  "weekStart": ""
}
