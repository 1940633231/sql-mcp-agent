# =============================================================================
# 环境变量全量模板（覆盖 agent/config.py 与 mcp_server/config.py 读取的所有变量）。
# 复制为 .env 后按需修改。默认值与其在代码中的兜底一致。
# 严禁在此填写真实密钥；请在你自己的 .env 中填写。
# 说明：agent.agent.SQLAgent 会检测 LLM_API_KEY 是否含「填入」字样以提示未配置。
# =============================================================================

# ---------------------------------------------------------------------------
# Agent：LLM（OpenAI 兼容协议，默认通义千问 / DashScope）
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 占位符含「填入」字样，SQLAgent.__init__ 据此提前识别未配置而拒绝启动
LLM_API_KEY=填入你的OpenAI兼容APIKey
LLM_MODEL=qwen-plus
LLM_MAX_TOOL_ITERATIONS=10   # 单个问题最多「LLM 调工具」轮数（迭代预算上限）

# ---- LLM 超时与重试（V0.6 可靠性） ----
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_READ_TIMEOUT_SECONDS=60
LLM_WRITE_TIMEOUT_SECONDS=60
LLM_POOL_TIMEOUT_SECONDS=5
LLM_MAX_CALL_SECONDS=90      # 单次模型调用兜底超时
LLM_MAX_RETRIES=3            # 临时错误（网络/限流/5xx）最大重试；4xx 不重试

# ---- 全局请求截止时间（V0.6 可靠性） ----
REQUEST_DEADLINE_SECONDS=120 # 超时后停止继续修复/调用

# ---- MCP 调用超时与临时错误重试（V0.6，仅只读可重试） ----
MCP_CONNECT_TIMEOUT_SECONDS=5
MCP_CALL_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=2
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=4.0

# ---- 统一预算（V0.6 可靠性，杜绝无限循环 / 无界修复） ----
MAX_TOOL_CALLS=40            # 单问题工具调用总数上限
MAX_SQL_REPAIRS=3            # SQL 修复次数上限
MAX_TOKENS=0                 # Token 上限；0=不限制
MAX_COST=0                   # 费用上限（美元）；0=不限制
# 模型单价覆盖，格式：模型名=输入单价,输出单价（美元/百万token）；分号分隔多个
MODEL_PRICES=
LLM_INPUT_PRICE=0.002        # 未收录模型的默认输入单价（美元/百万token）
LLM_OUTPUT_PRICE=0.008       # 未收录模型的默认输出单价（美元/百万token）

# ---- 工具暴露与重试边界（逗号分隔工具名） ----
# Agent 一律不得调用的工具（有副作用 / 服务端管理操作）
BLOCKED_TOOLS=publish_permission_policy,reload_permission_policy
# 可安全重试的只读工具白名单；不在白名单内的工具至多执行一次（失败即终止）
RETRY_SAFE_TOOLS=list_tables,get_schema,search_schema,run_query,sales_summary,company_ranking,industry_analysis

# ---- Agent：MCP Server 端点（与服务端共享读取） ----
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
# 服务端 AUTH_MODE=static 时的 Bearer Token（代表某个 principal）
MCP_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# MCP Server：传输与业务库
# ---------------------------------------------------------------------------
MCP_TRANSPORT=http           # http（Streamable HTTP 常驻服务）或 stdio（子进程管道）

MYSQL_HOST=172.23.97.35
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=sales_demo
MYSQL_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# MCP Server：身份 / RBAC
# ---------------------------------------------------------------------------
# disabled=本地开发身份；static=使用 AUTH_TOKENS_JSON 的 Bearer Token
AUTH_MODE=disabled
AUTH_ISSUER_URL=http://localhost:8000
AUTH_RESOURCE_URL=
AUTH_REQUIRED_SCOPES=
# Bearer Token 映射（合法 JSON，仅 AUTH_MODE=static 时生效）
# AUTH_TOKENS_JSON={"token-123456":"{\"roles\":[\"query-admin\"]}"}
# policy=仅使用服务端主体验证；claims=使用 JWT claims 角色映射
AUTH_PRINCIPAL_MODE=policy

# ---- 外部 OAuth 2.1 / JWT Resource Server ----
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_JWKS_URL=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHMS=RS256
AUTH_JWT_LEEWAY=30
AUTH_JWT_SUBJECT_CLAIM=sub
AUTH_JWT_ROLES_CLAIM=roles
AUTH_JWT_SCOPES_CLAIM=scope
AUTH_JWT_ATTRIBUTES_JSON=
AUTH_JWT_ROLE_MAP_JSON=
AUTH_ALLOW_RAW_ROLE_CLAIMS=false

# ---------------------------------------------------------------------------
# MCP Server：权限策略存储 / 热加载
# ---------------------------------------------------------------------------
POLICY_STORE=file            # file=configs/permissions.yaml；mysql=版本表 + active 指针
POLICY_RELOAD_SECONDS=5
# POLICY_STORE=mysql 时所需的独立策略库连接
POLICY_DB_HOST=
POLICY_DB_PORT=
POLICY_DB_USER=
POLICY_DB_PASSWORD=
POLICY_DB_DATABASE=
POLICY_DB_CHARSET=utf8mb4
POLICY_DB_CONNECT_TIMEOUT=10

# ---- 数据库连接池 ----
DB_POOL_SIZE=10
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_MAX_USAGE=0          # 0=不限制
POLICY_DB_POOL_SIZE=2
DB_POOL_PING=true

# ---- Schema 缓存 / Schema Intelligence / Domain（V0.4/V0.5） ----
SCHEMA_CACHE_TTL_SECONDS=60
SCHEMA_CACHE_MAX_ENTRIES=256
SCHEMA_DESC_PATH=            # 语义元数据文件路径（默认 configs/schema_desc.yaml）
DOMAIN_QUERIES_PATH=         # 领域查询定义文件路径（默认 configs/domain_queries.yaml）

# ---- 审计（V0.7：异步写入 / 失败策略 / 保留与归档） ----
AUDIT_STORE=log              # log=落日志；mysql=写审计表（需 AUTH/策略库连接）
AUDIT_REQUIRED=false         # true 时 log_event 会同步等待本次事件落库（保证必须入库）
AUDIT_ASYNC=true             # true=后台异步批量写；false=进程内同步写（低吞吐）
AUDIT_FAILURE=warn           # ignore=丢弃 / warn=记日志 / fail=标记不健康(暴露到 /healthz)
AUDIT_RETENTION_DAYS=30      # 保留周期：超过该天数的行被清理
AUDIT_ARCHIVE=false          # true=清理前先把过期行归档到归档表
AUDIT_ARCHIVE_TABLE=request_audit_events_archive
AUDIT_QUEUE_SIZE=10000       # 审计队列上限（有界，满时按失败策略处理）
AUDIT_MAINT_INTERVAL_SECONDS=300  # 保留/归档维护周期

# ---- 遥测 / 告警（V0.7 Observability） ----
# OpenTelemetry OTLP/HTTP 端点（含 /v1/traces）；留空=仅进程内缓冲，可经 /traces 查看
OTEL_OTLP_HTTP_ENDPOINT=
OTEL_SERVICE_NAME=mysql-sql-agent
OTEL_SAMPLE_RATIO=1.0        # 采样率（0~1）
OTEL_EXPORTER_BATCH_SECONDS=5
ALERT_RULES_PATH=            # 告警规则文件（默认 configs/alerts.yaml）
ALERT_EVAL_SECONDS=30        # 进程内告警评估周期

# ---- 优雅退出 ----
SHUTDOWN_GRACE_SECONDS=20