# =============================================================================
# Minimal local development template.
# Copy to .env, then change passwords/keys as needed.
# Only common local settings are active; optional modes stay commented.
# =============================================================================

# ---------- LLM ----------
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=填入你的OpenAI兼容APIKey
LLM_MODEL=qwen-plus
LLM_MAX_TOOL_ITERATIONS=10

# ---------- MCP transport ----------
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

# ---------- Business database ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=sales_demo
MYSQL_CONNECT_TIMEOUT=10

# ---------- Local authentication / policy ----------
AUTH_MODE=disabled
AUTH_RESOURCE_URL=http://127.0.0.1:8000/mcp
POLICY_STORE=file

# =============================================================================
# Optional modes. Uncomment only the group you use.
# Other settings keep their defaults from agent/config.py and mcp_server/config.py.
# =============================================================================

# ---------- Static Bearer Token ----------
# Token maps to a principal subject defined in configs/permissions.yaml.
# AUTH_MODE=static
# MCP_AUTH_TOKEN=alice-token
# AUTH_TOKENS_JSON={"alice-token":"alice","policy-token":"policy-admin"}

# ---------- External OAuth 2.1 / JWT ----------
# AUTH_MODE=jwt
# AUTH_PRINCIPAL_MODE=policy
# AUTH_JWT_ISSUER=https://issuer.example
# AUTH_JWT_AUDIENCE=http://127.0.0.1:8000/mcp
# AUTH_JWT_JWKS_URL=https://issuer.example/.well-known/jwks.json
# AUTH_JWT_ALGORITHMS=RS256
# AUTH_JWT_PUBLIC_KEY=
# AUTH_JWT_SECRET=
# MCP_AUTH_TOKEN=<access-token>

# ---------- MySQL policy store ----------
# POLICY_STORE=mysql
# POLICY_DB_HOST=127.0.0.1
# POLICY_DB_PORT=3306
# POLICY_DB_USER=policy_app
# POLICY_DB_PASSWORD=change-me
# POLICY_DB_DATABASE=mcp_policy
# POLICY_DB_CONNECT_TIMEOUT=10

# ---------- Audit persistence ----------
# AUDIT_STORE=mysql
# AUDIT_REQUIRED=false
# AUDIT_ASYNC=true
# AUDIT_FAILURE=warn
# AUDIT_RETENTION_DAYS=30
# AUDIT_ARCHIVE=false

# ---------- OTLP tracing ----------
# OTEL_OTLP_HTTP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=mysql-sql-agent
# OTEL_SAMPLE_RATIO=1.0
# OTEL_EXPORTER_BATCH_SECONDS=5

# ---------- In-process alerts ----------
# ALERT_RULES_PATH=configs/alerts.yaml
# ALERT_EVAL_SECONDS=30
