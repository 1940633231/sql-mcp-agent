# ===== MySQL 连接 =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=改成你的数据库密码
MYSQL_DATABASE=sales_demo

# ===== LLM（OpenAI 兼容协议，默认为通义千问 / DashScope）=====
# 其它兼容厂商示例：
#   DeepSeek:  LLM_BASE_URL=https://api.deepseek.com     LLM_MODEL=deepseek-chat
#   硅基流动:   LLM_BASE_URL=https://api.siliconflow.cn/v1 LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#   其它:       任意 OpenAI 兼容端点
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=在这里填入你的API_Key
LLM_MODEL=qwen-plus

# ===== Agent 行为 =====
# 单个问题最多允许的「LLM 调工具」轮数，防止死循环
LLM_MAX_TOOL_ITERATIONS=10

# ===== MCP 传输 =====
# http  = Streamable HTTP，Server 作为常驻服务，Agent 通过 HTTP 连接（默认）
# stdio = 子进程管道模式（python -m mcp_server.server 以 stdio 运行）
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

# ===== Authentication / RBAC（V0.3）=====
# disabled = 本地开发身份 local-dev（默认，保留 v0.2 用法）
# static   = 启用静态 Bearer Token（本地/测试）
# jwt      = 外部 OAuth 2.1 Resource Server，校验 JWT/JWKS
AUTH_MODE=disabled
# JSON: token -> 权限策略中的 principal subject
# AUTH_TOKENS_JSON={"alice-token":"alice","policy-token":"policy-admin"}
AUTH_TOKENS_JSON=
AUTH_ISSUER_URL=http://localhost:8000
AUTH_RESOURCE_URL=http://127.0.0.1:8000/mcp
# AUTH_REQUIRED_SCOPES=query:run,schema:read
AUTH_REQUIRED_SCOPES=

# ===== External OAuth 2.1 / JWT（AUTH_MODE=jwt）=====
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=http://127.0.0.1:8000/mcp
AUTH_JWT_JWKS_URL=
# 二选一：JWKS URL 或静态 PEM 公钥；HS256 测试可用 AUTH_JWT_SECRET。
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHMS=RS256
AUTH_JWT_LEEWAY=30
AUTH_JWT_SUBJECT_CLAIM=sub
AUTH_JWT_ROLES_CLAIM=roles
AUTH_JWT_SCOPES_CLAIM=scope
# claim -> principal attribute；例如 tenant_id/region_id/company_ids
AUTH_JWT_ATTRIBUTES_JSON={"industry":"industry","company_ids":"company_ids"}
AUTH_JWT_ROLE_MAP_JSON={}
AUTH_ALLOW_RAW_ROLE_CLAIMS=false
# policy: 只认服务端 principal；claims: 使用服务端角色映射后的 JWT claims。
AUTH_PRINCIPAL_MODE=policy

# ===== Permission Policy Store =====
# file = configs/permissions.yaml；mysql = 版本表 + active 指针。
POLICY_STORE=file
POLICY_RELOAD_SECONDS=5
POLICY_DB_HOST=127.0.0.1
POLICY_DB_PORT=3306
POLICY_DB_USER=policy_app
POLICY_DB_PASSWORD=修改为策略库密码
POLICY_DB_DATABASE=mcp_policy
POLICY_DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=10
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_MAX_USAGE=0
DB_POOL_PING=true
POLICY_DB_POOL_SIZE=2

# ===== Schema / Audit / Lifecycle =====
SCHEMA_CACHE_TTL_SECONDS=60
SCHEMA_CACHE_MAX_ENTRIES=256
# V0.4 Schema Intelligence：语义元数据文件路径；留空则用 configs/schema_desc.yaml。
SCHEMA_DESC_PATH=
# log = 结构化日志；mysql = 写入独立 Policy DB 的 request_audit_events。
AUDIT_STORE=log
AUDIT_REQUIRED=false
SHUTDOWN_GRACE_SECONDS=20

# Agent 客户端侧使用的 Token；AUTH_MODE=static/jwt 时必填。
MCP_AUTH_TOKEN=

# ===== 说明 =====
# 1. 复制本文件为 .env 后填写真实值，切勿提交 .env（已在 .gitignore 拦截）
# 2. 数据库建议使用只读账号：仅 SELECT 权限，配合 mcp_server 的只读校验
