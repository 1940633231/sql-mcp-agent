# ===== MySQL 连接 =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=改成你的数据库密码
MYSQL_DATABASE=sales_demo

# ===== LLM（OpenAI 兼容协议，默认为通义千问 / DashScope）=====
# 其它兼容厂商示例：
#   DeepSeek:  LLM_BASE_URL=https://api.deepseek.com     LLM_MODEL=deepseek-chat
#   硅基流动:   LLM_BASE_URL=https://api.siliconflow.cn/v1 LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#   其它:       任意 OpenAI 兼容端点
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=在这里填入你的API_Key
LLM_MODEL=qwen-plus

# ===== Agent 行为 =====
# 单个问题最多允许的「LLM 调工具」轮数，防止死循环
LLM_MAX_TOOL_ITERATIONS=10

# ===== 说明 =====
# 1. 复制本文件为 .env 后填写真实值，切勿提交 .env（已在 .gitignore 拦截）
# 2. 数据库建议使用只读账号：仅 SELECT 权限，配合 mcp_server.py 的双重只读校验